# ============================================================================
#  PhotoMatch AI — environment variables
#  ONE file is shared by all three apps (api, web, ai) to keep setup simple.
#  Run `npm run setup` to create .env from this file, then fill in the blanks.
#  Values marked (optional) can stay empty — that feature is simply switched off.
# ============================================================================

# ---------- General ----------
NODE_ENV=development
# Port the Node API listens on.
PORT=3000
# The public URL people open in the browser. In development this is the Vite
# dev server, which forwards /api/* to the API. In production it is your domain.
# When testing Telegram/WhatsApp locally, put your HTTPS tunnel URL here.
APP_URL=http://localhost:5173

# ---------- Database (PostgreSQL + pgvector) ----------
# `docker compose up -d db` starts a matching database for you.
DATABASE_URL=postgresql://photomatch:photomatch@localhost:5432/photomatch

# ---------- Authentication (better-auth) ----------
# Long random string used to sign sessions. `npm run setup` generates one.
BETTER_AUTH_SECRET=
# (optional) Google login. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (verification + password reset) ----------
# (optional in development) If SMTP_USER is empty, emails are printed to the
# API console instead of being sent, so you can still click the links.
# Gmail: use smtp.gmail.com / 465 and an "App password".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PhotoMatch AI <no-reply@photomatch.ai>

# ---------- Image storage (Cloudinary) ----------
# https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- AI service (Python, apps/ai) ----------
AI_SERVICE_URL=http://localhost:8000
# Shared secret so only our API can call the AI service. `npm run setup` generates one.
AI_SERVICE_SECRET=
# How similar two faces must be (cosine similarity, 0–1) to count as the same person.
# Higher = stricter (fewer wrong photos, but may miss some). 0.45 works well for the ArcFace model we use.
FACE_MATCH_THRESHOLD=0.45
# Minimum "real person" probability from the anti-spoofing models (0–1). Live faces score ~1.0, photos of photos/screens far lower.
LIVENESS_THRESHOLD=0.7

# ---------- Telegram bot (optional) ----------
# Create a bot with @BotFather and paste its token + username (without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram sends back with every webhook call. `npm run setup` generates one.
TELEGRAM_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (optional) ----------
# https://developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The business phone number guests message, digits only with country code (e.g. 919876543210).
WHATSAPP_BUSINESS_NUMBER=
# You invent this; paste the same value in Meta's webhook settings. `npm run setup` generates one.
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic → App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
